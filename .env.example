APP_NAME="Home Putra Interior"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Web Push (VAPID) — generate with: php artisan tinker → Minishlink\WebPush\VAPID::createVapidKeys()
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
WEBPUSH_ALLOWED_ENDPOINT_SUFFIXES=.notify.windows.com
WEBPUSH_MAX_SUBSCRIPTIONS_PER_USER=10

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_report
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_CONNECTION=
# SECURITY: In production, set to true for HTTPS-only cookies (MITM protection)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
# Set to the shared parent domain in production when frontend and API use subdomains.
# SESSION_DOMAIN=.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
SANCTUM_EXPIRATION=720

CACHE_STORE=file
QUEUE_CONNECTION=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============================================
# PRODUCTION EXAMPLE (Copy ke .env di server)
# ============================================
# APP_NAME="Home Putra Interior"
# APP_ENV=production
# APP_KEY=base64:XXXXX... (generate dengan: php artisan key:generate)
# APP_DEBUG=false
# APP_URL=https://homeputrainterior.com
# FRONTEND_URLS=https://app.homeputrainterior.com
# SANCTUM_STATEFUL_DOMAINS=app.homeputrainterior.com
# SESSION_DOMAIN=.homeputrainterior.com
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=lax
#
# LOG_CHANNEL=stack
# LOG_LEVEL=error
#
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
