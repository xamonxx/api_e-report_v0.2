# syntax=docker/dockerfile:1.7

# Target:
#   php   — PHP-FPM (127.0.0.1:9100). Dipakai be-php/queue/scheduler/reverb di serverone.
#   web   — nginx sidecar (127.0.0.1:8100) yang melayani public/ + FastCGI ke target php.
#   local — default (stage terakhir). `artisan serve` untuk docker-compose.prod.yml lokal.
# Lihat deploy/serverone/README.md.

ARG COMPOSER_IMAGE=composer:2.10.3@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac
ARG PHP_IMAGE=php:8.3.35-fpm-bookworm@sha256:f768bd9142444f6126a690697b028c23f30878c3b628a7c355dfce75e29cc045
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.30-alpine@sha256:782bb89768cc87b7f95c18b95baa1af250e5d451f26794f59363540161147c01

FROM ${COMPOSER_IMAGE} AS composer

FROM ${PHP_IMAGE} AS php

LABEL org.opencontainers.image.source="https://github.com/xamonxx/api_e-report_v0.2"

# Ekstensi disamakan dengan php-fpm-83 native serverone (audit 2026-10-17):
# gmp/soap/sockets ada di server, jadi ikut dipasang supaya perilaku identik.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libzip-dev \
        libpng-dev \
        libicu-dev \
        libonig-dev \
        libgmp-dev \
        libxml2-dev \
        curl \
    && docker-php-ext-install pdo_mysql mysqli mbstring gd zip intl bcmath pcntl opcache gmp soap sockets \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --link --from=composer /usr/bin/composer /usr/bin/composer
COPY --link docker/php/ereport.ini /usr/local/etc/php/conf.d/zz-ereport.ini
COPY --link docker/php-fpm/zz-ereport.conf /usr/local/etc/php-fpm.d/zz-ereport.conf

WORKDIR /var/www/html

COPY --link composer.json composer.lock ./
RUN composer install --no-interaction --no-scripts --no-progress --no-dev --optimize-autoloader \
    && composer clear-cache

COPY --link . .
RUN composer dump-autoload --optimize --no-dev

COPY --link docker/entrypoint.sh /usr/local/bin/entrypoint.sh
# public/storage dibuat relatif di image, jadi tidak perlu `storage:link` saat runtime
# dan tidak pernah berisi path absolut OS lain (lihat Lessons-Log symlink lintas-OS).
# bootstrap/cache dibuka untuk uid mana pun karena serverone menjalankan container
# sebagai www native (1001:1002), bukan www-data.
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && ln -sfn ../storage/app/public public/storage \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R a+rwX /var/www/html/bootstrap/cache

USER www-data
ENTRYPOINT ["entrypoint.sh"]
CMD ["php-fpm"]

FROM ${NGINX_IMAGE} AS web

LABEL org.opencontainers.image.source="https://github.com/xamonxx/api_e-report_v0.2"

COPY --link docker/nginx/serverone.conf /etc/nginx/conf.d/default.conf
COPY --link --from=php /var/www/html/public /var/www/html/public

FROM php AS local

EXPOSE 8000
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
